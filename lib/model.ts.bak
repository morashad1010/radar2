// The pre-token radar's value model.
//
// Everything the board claims is derived from the snapshot's own fields. A protocol records no token
// when both its CoinGecko id and its ticker are null; those protocols are ranked by an implied value
// built from what live peers in the same category trade at, adjusted for TVL growth, the time the
// protocol has run without a token, and how many chains it runs on. No protocol name is special-cased.

export interface Protocol {
  slug: string;
  name: string;
  category: string | null;
  chains: string[];
  tvl_usd: number;
  change_7d: number | null;
  mcap_usd: number | null;
  listed_at: string | null;
  gecko_id: string | null;
  symbol: string | null;
}

export interface Snapshot {
  as_of: string;
  source: string;
  floor_usd: number;
  protocols: Protocol[];
  watchlist: string[];
}

/** The four multipliers, the resulting multiple and the dollar value one protocol earns. */
export interface Score {
  base: number;
  growth: number;
  age: number;
  chain_factor: number;
  multiple: number;
  implied_value_usd: number;
  age_days: number | null;
  age_known: boolean;
}

/** One ranked row: the board's unit, and the dashboard's row. */
export interface Row {
  rank: number;
  slug: string;
  name: string;
  category: string | null;
  chains: string[];
  tvl_usd: number;
  change_7d: number | null;
  age_days: number | null;
  base: number;
  growth: number;
  age: number;
  chain_factor: number;
  multiple: number;
  implied_value_usd: number;
  farm_steps: string[];
  on_watchlist: boolean;
}

/** A live-token protocol shown next to the board: the market's own value, not the model's. */
export interface LivePeer {
  slug: string;
  name: string;
  category: string | null;
  tvl_usd: number;
  mcap_usd: number;
  ratio: number;
}

/** One category's calibrating median, from its live peers. */
export interface CategoryMedian {
  category: string;
  median_ratio: number;
  peers: number;
}

export interface Stats {
  protocols: number;
  pre_token: number;
  live: number;
  watchlist: number;
  rows: number;
  pre_token_tvl: number;
  watchlist_tvl: number;
  max_implied: number;
  median_multiple: number;
}

/** Everything the dashboard reads, written beside it as data.js. */
export interface Radar {
  as_of: string;
  source: string;
  floor_usd: number;
  stats: Stats;
  category_medians: CategoryMedian[];
  live_peers: LivePeer[];
  rows: Row[];
}

export class SnapshotError extends Error {
  constructor(message: string) {
    super(message);
    this.name = 'SnapshotError';
  }
}

const DAY_MS = 86_400_000;
const MIN_PEER_TVL = 5_000_000;

const clamp = (n: number, lo: number, hi: number): number => Math.min(hi, Math.max(lo, n));
const round = (n: number, digits: number): number => {
  const f = 10 ** digits;
  return Math.round(n * f) / f;
};

/** The lower median of a non-empty list (the mean of the middle pair when the count is even). */
function median(values: number[]): number | null {
  if (values.length === 0) return null;
  const sorted = values.slice().sort((a, b) => a - b);
  const mid = sorted.length >> 1;
  if (sorted.length % 2 === 1) return sorted[mid]!;
  return (sorted[mid - 1]! + sorted[mid]!) / 2;
}

const isDate = (s: string): boolean => /^\d{4}-\d{2}-\d{2}$/.test(s) && !Number.isNaN(Date.parse(`${s}T00:00:00Z`));

/** Whole days from `listedAt` to `asOf`, both read as UTC dates; null when either is missing. */
export function ageDays(asOf: string, listedAt: string | null): number | null {
  if (listedAt === null) return null;
  const a = Date.parse(`${asOf}T00:00:00Z`);
  const b = Date.parse(`${listedAt}T00:00:00Z`);
  if (Number.isNaN(a) || Number.isNaN(b)) return null;
  return Math.max(0, Math.floor((a - b) / DAY_MS));
}

/** A protocol records no token when neither an id nor a ticker is on file. */
export function isPreToken(p: Protocol): boolean {
  return p.gecko_id === null && p.symbol === null;
}

/**
 * The market multiple a live protocol trades at, or null when it cannot calibrate: it needs a market
 * cap, at least $5m of TVL, and a ratio inside (0, 20].
 */
function peerRatio(p: Protocol): number | null {
  if (p.mcap_usd === null || p.tvl_usd < MIN_PEER_TVL) return null;
  const ratio = p.mcap_usd / p.tvl_usd;
  return ratio > 0 && ratio <= 20 ? ratio : null;
}

/** Score one protocol against an already-clipped category base. */
export function scoreProtocol(p: Protocol, asOf: string, base: number): Score {
  const days = ageDays(asOf, p.listed_at);
  const ageKnown = days !== null;
  const growth = p.change_7d === null ? 1 : 1 + (clamp(p.change_7d, -40, 80) / 100) * 0.6;
  const age = ageKnown ? 0.92 + Math.min(days! / 365, 5) * 0.05 : 1;
  const chainFactor = 1 + 0.04 * Math.min(p.chains.length - 1, 3);
  const multiple = round(clamp(base * growth * age * chainFactor, 0.05, 1.75), 4);
  const implied = Math.max(1, Math.round(p.tvl_usd * multiple));
  return {
    base: round(base, 4),
    growth: round(growth, 4),
    age: round(age, 4),
    chain_factor: round(chainFactor, 4),
    multiple,
    implied_value_usd: implied,
    age_days: days,
    age_known: ageKnown,
  };
}

// ---------------------------------------------------------------- farm plans

/** Gas for one transaction on a chain, in dollars. */
const GAS_USD: Record<string, number> = {
  Ethereum: 6,
  Arbitrum: 0.3,
  Optimism: 0.3,
  Base: 0.3,
  Polygon: 0.4,
  BSC: 0.4,
  Avalanche: 0.4,
  Solana: 0.02,
  Tron: 1,
};

const gasUsd = (chain: string): number => GAS_USD[chain] ?? 0.5;
const moneyUsd = (n: number): string => `$${n.toFixed(2)}`;

type Family = 'lending' | 'dex' | 'staking' | 'vault' | 'bridge' | 'rwa' | 'derivatives' | 'chain' | 'generic';

/** The plan family a DefiLlama category belongs to. */
function familyOf(category: string | null): Family {
  const c = (category ?? '').toLowerCase();
  if (c.includes('lend') || c.includes('cdp') || c.includes('collateral')) return 'lending';
  if (c.includes('dex') || c.includes('amm')) return 'dex';
  if (c.includes('liquid stak') || c.includes('restak') || c.includes('staking') || c.includes('anchor btc')) return 'staking';
  if (c.includes('bridge')) return 'bridge';
  if (c.includes('rwa')) return 'rwa';
  if (c.includes('yield') || c.includes('curator') || c.includes('allocator') || c.includes('vault') || c.includes('farm') || c.includes('index') || c.includes('liquidity manager')) return 'vault';
  if (c.includes('derivative') || c.includes('basis') || c.includes('option') || c.includes('perpetual') || c.includes('synthetic') || c.includes('interest rate')) return 'derivatives';
  if (c === 'chain' || c.includes('l2') || c.includes('rollup')) return 'chain';
  return 'generic';
}

/** One step's action, its cost and its time, joined into the one string the board carries. */
function makeStep(action: string, cost: string, time: string): string {
  const tail = ` — cost ${cost} — time ${time}.`;
  let body = action.trim();
  const room = 600 - tail.length;
  if (body.length > room) body = body.slice(0, Math.max(1, room)).trimEnd();
  let out = body + tail;
  if (out.length < 20) out = `${out} Read the protocol's own page before you start.`;
  return out;
}

/**
 * A farm plan for one protocol: six steps, each naming what it costs and how long it takes. The
 * ticket, gas, hold and bridge destination all come from the protocol's own TVL, chains and age.
 */
export function farmPlan(p: Protocol, score: Score): string[] {
  const primary = p.chains[0] ?? 'its main chain';
  const g = gasUsd(primary);
  const ticket = p.tvl_usd >= 200_000_000 ? 250 : p.tvl_usd >= 50_000_000 ? 150 : 100;
  const ticketUsd = `$${ticket}`;
  const borrow = Math.round(ticket * 0.4);
  const hold = score.age_days !== null && score.age_days < 180 ? 45 : 30;
  const dest = p.chains[1] ?? (primary === 'Ethereum' ? 'Base' : 'Ethereum');
  const destGas = gasUsd(dest);
  const bridgeFrom = primary === 'Ethereum' ? 'Arbitrum' : 'Ethereum';

  let plan: Array<[string, string, string]>;

  switch (familyOf(p.category)) {
    case 'lending':
      plan = [
        [`Open a position on ${p.name} on ${primary} and supply ${moneyUsd(ticket)} of USDC as collateral`, `~${moneyUsd(g * 2)} of gas for the approval and the supply`, '15 minutes'],
        [`Borrow ${moneyUsd(borrow)} against it and keep the health factor above 1.6`, `~${moneyUsd(g)} of gas`, '10 minutes'],
        [`Redeploy the borrowed ${moneyUsd(borrow)} into a stable pair on a second venue for the hold`, `~${moneyUsd(g * 2)} of gas`, '20 minutes'],
        ['Check the health factor and the borrow rate once a week and repay part of the debt if the factor falls under 1.5', `nothing to read, ~${moneyUsd(g)} to adjust`, '10 minutes a week'],
        [`Keep ${moneyUsd(ticket)} of collateral in place for ${hold} days so the activity spans more than one snapshot`, `the ${moneyUsd(ticket)} stays lent`, `${hold} days`],
        [`Withdraw: repay the ${moneyUsd(borrow)} debt, withdraw the collateral and claim any points the protocol publishes, if the protocol issues one`, `~${moneyUsd(g * 2)} of gas`, '20 minutes'],
      ];
      break;

    case 'dex':
      plan = [
        [`Choose the deepest ${p.name} pool on ${primary} with at least $1m of liquidity and approve both tokens`, `~${moneyUsd(g * 2)} of gas for the two approvals`, '15 minutes'],
        [`Provide ${moneyUsd(ticket)} of liquidity in a range 15% either side of the current price`, `~${moneyUsd(g)} of gas plus the ${moneyUsd(ticket)} ticket`, '20 minutes'],
        ['Rebalance the range when price leaves it, about every 14 days at current volatility', `~${moneyUsd(g * 2)} of gas per rebalance`, '30 minutes every 14 days'],
        ['Claim trading fees once a month and compound them into the same position', `~${moneyUsd(g)} of gas a month`, '10 minutes a month'],
        [`Hold the position for ${hold} days`, `the ${moneyUsd(ticket)} stays in the pool and can lose to divergence`, `${hold} days`],
        ['Exit: remove the liquidity, swap both tokens back to USDC and claim any published rewards', `~${moneyUsd(g * 3)} of gas`, '25 minutes'],
      ];
      break;

    case 'staking':
      plan = [
        [`Mint the receipt token with ${moneyUsd(ticket)} of the ${primary} staking asset`, `~${moneyUsd(g)} of gas plus the ${moneyUsd(ticket)} ticket`, '10 minutes'],
        [`Restake the receipt with ${p.name} if its app offers a route, otherwise hold the receipt`, `~${moneyUsd(g * 2)} of gas when a route exists`, '15 minutes'],
        ['Loop the position once only if the borrow rate is under the staking yield', `~${moneyUsd(g * 3)} of gas`, '20 minutes'],
        [`Hold the receipt for ${hold} days`, `the ${moneyUsd(ticket)} stays staked`, `${hold} days`],
        [`Check the withdrawal queue once a week, since unstaking can take 3 to 10 days on ${primary}`, 'nothing to read', '5 minutes a week'],
        ['Exit: redeem the receipt, wait out the queue and claim published rewards', `~${moneyUsd(g * 2)} of gas`, 'up to 10 days plus 15 minutes'],
      ];
      break;

    case 'vault':
      plan = [
        [`Compare ${p.name} vaults on ${primary} and pick the one with the shortest lockup you can accept`, 'nothing but 20 minutes of reading', '20 minutes'],
        ['Read the curator fee before signing, since a 10% performance fee keeps a tenth of the yield', 'nothing, the fee is disclosed', '5 minutes'],
        [`Deposit ${moneyUsd(ticket)} into the chosen vault`, `~${moneyUsd(g)} of gas plus the ${moneyUsd(ticket)} ticket`, '15 minutes'],
        ['Note the lockup and the withdrawal window so you do not need the money inside it', `nothing, but the ${moneyUsd(ticket)} is locked`, '5 minutes'],
        [`Hold for ${hold} days`, `the ${moneyUsd(ticket)} stays in the vault`, `${hold} days`],
        ['Exit inside the withdrawal window and claim any points the vault publishes, if the protocol issues one', `~${moneyUsd(g)} of gas`, '20 minutes plus the lockup'],
      ];
      break;

    case 'bridge':
      plan = [
        [`Bridge ${moneyUsd(ticket)} of USDC from ${primary} to ${dest} through ${p.name}`, `~${moneyUsd(destGas + 1.5)} (a $1.50 bridge fee plus destination gas)`, '10 to 20 minutes'],
        [`Confirm the arrival on ${dest} in a block explorer before doing anything else`, 'nothing but a block explorer read', '5 minutes'],
        [`Use the bridged funds in two apps on ${dest} so the activity is not a bare transfer`, `~${moneyUsd(destGas * 2)} of gas`, '30 minutes'],
        ['Mind the withdrawal window, since a bridge out can take 1 to 7 days', 'nothing while you wait', '1 to 7 days'],
        [`Hold the position for ${hold} days`, `the ${moneyUsd(ticket)} stays on ${dest}`, `${hold} days`],
        [`Exit: bridge back to ${primary} and claim any published rewards`, `~${moneyUsd(g + 1.5)} (bridge fee plus gas)`, '10 to 20 minutes'],
      ];
      break;

    case 'rwa':
      plan = [
        [`Start ${p.name} allowlist or KYC step on ${primary} first, since approval is the long pole`, 'nothing but identity documents', '2 to 10 days for approval'],
        ['Wait for the next subscription window and note the minimum ticket before committing', 'nothing while the window is shut', 'up to 30 days'],
        [`Subscribe with ${moneyUsd(ticket)}, the size the protocol takes at this TVL`, `~${moneyUsd(g)} of gas plus the ${moneyUsd(ticket)} ticket`, '20 minutes in the window'],
        [`Hold the position for ${hold} days, since redemption is not instant`, `the ${moneyUsd(ticket)} stays subscribed`, `${hold} days`],
        ['Check the redemption notice period once a month and keep cash outside the lockup', 'nothing to read', '10 minutes a month'],
        ['Redeem in the next window and claim any published distribution, if the protocol issues one', `~${moneyUsd(g)} of gas`, 'up to 30 days plus 20 minutes'],
      ];
      break;

    case 'derivatives':
      plan = [
        [`Fund ${moneyUsd(ticket)} of USDC as margin on ${p.name} on ${primary}`, `~${moneyUsd(g)} of gas plus the ${moneyUsd(ticket)} ticket`, '15 minutes'],
        [`Open the basis: long the spot asset and short the ${p.name} perpetual for the same notional`, `~${moneyUsd(g * 2)} of gas and two fill fees`, '20 minutes'],
        ['Hedge the position so the funding payment, not the price, is what you hold', `~${moneyUsd(g)} of gas per adjustment`, '10 minutes'],
        ['Check the funding rate every 8 hours and close if it turns against the position', `nothing to read, ~${moneyUsd(g)} to close`, '5 minutes, three times a day'],
        [`Hold the basis for ${hold} days`, `the ${moneyUsd(ticket)} stays as margin`, `${hold} days`],
        ['Close both legs together and withdraw the margin', `~${moneyUsd(g * 2)} of gas for the two closes`, '20 minutes'],
      ];
      break;

    case 'chain':
      plan = [
        [`Bridge ${moneyUsd(ticket)} of USDC into ${p.name} from ${bridgeFrom}`, `~${moneyUsd(g + 1.5)} (a $1.50 bridge fee plus ${primary} gas)`, '10 to 20 minutes'],
        [`Use three native apps on ${p.name} with the bridged funds, one transaction each`, `~${moneyUsd(g * 3)} of gas`, '45 minutes'],
        ['Hold a little of the gas token so later transactions do not stall', `~${moneyUsd(g * 2)} for the gas you keep`, '5 minutes'],
        [`Hold the position for ${hold} days`, `the ${moneyUsd(ticket)} stays on ${p.name}`, `${hold} days`],
        ['Check for an official bridge-back route before you need it', 'nothing to read', '10 minutes'],
        ['Exit: bridge back and claim any published rewards, if the protocol issues one', `~${moneyUsd(g + 1.5)} (bridge fee plus gas)`, '10 to 20 minutes'],
      ];
      break;

    default:
      plan = [
        [`Read ${p.name} app on ${primary} and find the action that counts as real use, usually a deposit or a swap`, 'nothing but 15 minutes of reading', '15 minutes'],
        [`Approve and spend ${moneyUsd(ticket)} on that action`, `~${moneyUsd(g * 2)} of gas plus the ${moneyUsd(ticket)} ticket`, '20 minutes'],
        ['Repeat one small action each week so the record is not a single deposit', `~${moneyUsd(g)} of gas a week`, '10 minutes a week'],
        [`Hold the position for ${hold} days`, `the ${moneyUsd(ticket)} stays in the protocol`, `${hold} days`],
        ['Write the wallet, the dates and every transaction in a farm log', 'nothing but the log', '5 minutes'],
        [`Exit: withdraw the ${moneyUsd(ticket)}, swap back to USDC and claim any published rewards, if the protocol issues one`, `~${moneyUsd(g * 2)} of gas`, '20 minutes'],
      ];
      break;
  }

  return plan.map(([action, cost, time]) => makeStep(action, cost, time));
}

// ---------------------------------------------------------------- the radar

/** The snapshot's live-token protocols with the largest market caps, and the ratio each trades at. */
function livePeersOf(live: Protocol[]): LivePeer[] {
  return live
    .filter((p) => p.mcap_usd !== null)
    .sort((a, b) => b.mcap_usd! - a.mcap_usd! || b.tvl_usd - a.tvl_usd || (a.slug < b.slug ? -1 : a.slug > b.slug ? 1 : 0))
    .slice(0, 40)
    .map((p) => ({
      slug: p.slug,
      name: p.name,
      category: p.category,
      tvl_usd: p.tvl_usd,
      mcap_usd: p.mcap_usd!,
      ratio: round(p.tvl_usd > 0 ? p.mcap_usd! / p.tvl_usd : 0, 3),
    }));
}

/** Build the ranked board and the dashboard's whole dataset from one snapshot. */
export function buildRadar(snapshot: Snapshot): { board: Row[]; radar: Radar } {
  const protocols = snapshot.protocols;
  const pre = protocols.filter(isPreToken);
  const live = protocols.filter((p) => !isPreToken(p));

  const peerRatios = live.map(peerRatio).filter((r): r is number => r !== null);
  const overallMedian = median(peerRatios) ?? 0.5;

  const byCategory = new Map<string, number[]>();
  for (const p of live) {
    if (p.category === null) continue;
    const ratio = peerRatio(p);
    if (ratio === null) continue;
    const list = byCategory.get(p.category);
    if (list === undefined) byCategory.set(p.category, [ratio]);
    else list.push(ratio);
  }

  const categoryMedians: CategoryMedian[] = [...byCategory.entries()]
    .filter(([, ratios]) => ratios.length >= 4)
    .map(([category, ratios]) => ({ category, median_ratio: round(median(ratios)!, 4), peers: ratios.length }))
    .sort((a, b) => b.median_ratio - a.median_ratio || (a.category < b.category ? -1 : a.category > b.category ? 1 : 0));

  const baseFor = (p: Protocol): number => {
    if (p.category !== null) {
      const ratios = byCategory.get(p.category);
      if (ratios !== undefined && ratios.length >= 4) return clamp(median(ratios)!, 0.15, 1.2);
    }
    return clamp(overallMedian, 0.15, 1.2);
  };

  const watch = new Set(snapshot.watchlist);
  const scored = pre.map((p) => ({ p, score: scoreProtocol(p, snapshot.as_of, baseFor(p)) }));
  scored.sort(
    (a, b) =>
      b.score.implied_value_usd - a.score.implied_value_usd ||
      b.p.tvl_usd - a.p.tvl_usd ||
      (a.p.slug < b.p.slug ? -1 : a.p.slug > b.p.slug ? 1 : 0),
  );

  const board: Row[] = scored.map(({ p, score }, i) => ({
    rank: i + 1,
    slug: p.slug,
    name: p.name,
    category: p.category,
    chains: p.chains.slice(),
    tvl_usd: p.tvl_usd,
    change_7d: p.change_7d,
    age_days: score.age_days,
    base: score.base,
    growth: score.growth,
    age: score.age,
    chain_factor: score.chain_factor,
    multiple: score.multiple,
    implied_value_usd: score.implied_value_usd,
    farm_steps: farmPlan(p, score),
    on_watchlist: watch.has(p.slug),
  }));

  const stats: Stats = {
    protocols: protocols.length,
    pre_token: pre.length,
    live: live.length,
    watchlist: snapshot.watchlist.length,
    rows: board.length,
    pre_token_tvl: pre.reduce((sum, p) => sum + p.tvl_usd, 0),
    watchlist_tvl: protocols.filter((p) => watch.has(p.slug)).reduce((sum, p) => sum + p.tvl_usd, 0),
    max_implied: board.length === 0 ? 0 : board[0]!.implied_value_usd,
    median_multiple: round(median(board.map((r) => r.multiple)) ?? 0, 4),
  };

  const radar: Radar = {
    as_of: snapshot.as_of,
    source: snapshot.source,
    floor_usd: snapshot.floor_usd,
    stats,
    category_medians: categoryMedians,
    live_peers: livePeersOf(live),
    rows: board,
  };

  return { board, radar };
}

// ---------------------------------------------------------------- i/o

/** The snapshot out of the file's text, refused unless it carries the ten fields it should. */
export function parseSnapshot(text: string): Snapshot {
  let raw: unknown;
  try {
    raw = JSON.parse(text);
  } catch {
    throw new SnapshotError('snapshot.json is not JSON');
  }
  if (typeof raw !== 'object' || raw === null || Array.isArray(raw)) throw new SnapshotError('snapshot.json is not a JSON object');
  const o = raw as Record<string, unknown>;

  if (typeof o.as_of !== 'string' || !isDate(o.as_of)) throw new SnapshotError('snapshot.json has no valid as_of date');
  if (typeof o.source !== 'string' || o.source.trim() === '') throw new SnapshotError('snapshot.json has no source');
  if (typeof o.floor_usd !== 'number' || !Number.isSafeInteger(o.floor_usd) || o.floor_usd <= 0) {
    throw new SnapshotError('snapshot.json has no positive whole floor_usd');
  }
  if (!Array.isArray(o.protocols)) throw new SnapshotError('snapshot.json has no protocols array');
  if (!Array.isArray(o.watchlist) || o.watchlist.some((s) => typeof s !== 'string' || s.trim() === '')) {
    throw new SnapshotError('snapshot.json has no watchlist of slugs');
  }

  const seen = new Set<string>();
  const protocols: Protocol[] = o.protocols.map((value, i) => {
    if (typeof value !== 'object' || value === null || Array.isArray(value)) throw new SnapshotError(`snapshot.json's protocol ${i} is not an object`);
    const p = value as Record<string, unknown>;
    const where = `snapshot.json's protocol ${i}`;

    if (typeof p.slug !== 'string' || p.slug === '' || /\s/.test(p.slug)) throw new SnapshotError(`${where} has no slug without whitespace`);
    if (seen.has(p.slug)) throw new SnapshotError(`${where} repeats the slug ${p.slug}`);
    seen.add(p.slug);
    if (typeof p.name !== 'string' || p.name.trim() === '') throw new SnapshotError(`${where} has no name`);
    if (p.category !== null && typeof p.category !== 'string') throw new SnapshotError(`${where} has a category that is neither a string nor null`);
    if (!Array.isArray(p.chains) || p.chains.some((c) => typeof c !== 'string')) throw new SnapshotError(`${where} has no chains array of names`);
    if (typeof p.tvl_usd !== 'number' || !Number.isFinite(p.tvl_usd) || p.tvl_usd < 0) throw new SnapshotError(`${where} has no finite TVL`);
    if (p.change_7d !== null && (typeof p.change_7d !== 'number' || !Number.isFinite(p.change_7d))) {
      throw new SnapshotError(`${where} has a 7-day change that is neither a number nor null`);
    }
    if (p.mcap_usd !== null && (typeof p.mcap_usd !== 'number' || !Number.isFinite(p.mcap_usd) || p.mcap_usd < 0)) {
      throw new SnapshotError(`${where} has a market cap that is neither a non-negative number nor null`);
    }
    if (p.listed_at !== null && (typeof p.listed_at !== 'string' || !isDate(p.listed_at))) {
      throw new SnapshotError(`${where} has a listing date that is neither YYYY-MM-DD nor null`);
    }
    if (p.gecko_id !== null && (typeof p.gecko_id !== 'string' || p.gecko_id.trim() === '')) {
      throw new SnapshotError(`${where} has a CoinGecko id that is neither a string nor null`);
    }
    if (p.symbol !== null && (typeof p.symbol !== 'string' || p.symbol.trim() === '')) {
      throw new SnapshotError(`${where} has a symbol that is neither a string nor null`);
    }

    return {
      slug: p.slug,
      name: p.name,
      category: p.category,
      chains: p.chains.slice() as string[],
      tvl_usd: p.tvl_usd,
      change_7d: p.change_7d,
      mcap_usd: p.mcap_usd,
      listed_at: p.listed_at,
      gecko_id: p.gecko_id,
      symbol: p.symbol,
    };
  });

  return {
    as_of: o.as_of,
    source: o.source,
    floor_usd: o.floor_usd,
    protocols,
    watchlist: [...new Set(o.watchlist as string[])],
  };
}

/** A board's first gate violation, or null when the gate would take it. */
export function boardIssue(board: Row[], snapshot: Snapshot): string | null {
  if (board.length < 100 || board.length > 4000) return `the board holds ${board.length} rows, outside 100..4000`;

  const known = new Set(snapshot.protocols.map((p) => p.slug));
  const slugs = new Set<string>();
  for (const r of board) {
    if (!known.has(r.slug)) return `${r.slug} is not a snapshot protocol`;
    if (slugs.has(r.slug)) return `${r.slug} appears on the board twice`;
    if (/\s/.test(r.slug)) return `${r.slug} has whitespace in its slug`;
    slugs.add(r.slug);
    if (typeof r.name !== 'string' || r.name.trim() === '') return `${r.slug} has no name`;
  }

  const ranks = board.map((r) => r.rank).sort((a, b) => a - b);
  for (let i = 0; i < ranks.length; i++) {
    if (ranks[i] !== i + 1) return `rank ${i + 1} is ${ranks[i]}, so the ranks are not 1..${board.length}`;
  }

  for (let i = 0; i < board.length; i++) {
    const r = board[i]!;
    if (r.rank !== i + 1) return `row ${i + 1} carries rank ${r.rank}`;
    if (!Number.isSafeInteger(r.implied_value_usd) || r.implied_value_usd <= 0 || r.implied_value_usd > 100_000_000_000_000) {
      return `${r.slug} has implied value ${r.implied_value_usd}, not a positive whole number within 1e14`;
    }
    if (i > 0 && r.implied_value_usd > board[i - 1]!.implied_value_usd) return `${r.slug} outranks the row above it on implied value`;
    if (!Array.isArray(r.farm_steps) || r.farm_steps.length < 3 || r.farm_steps.length > 12) {
      return `${r.slug} has ${Array.isArray(r.farm_steps) ? r.farm_steps.length : 0} farm steps, outside 3..12`;
    }
    for (const step of r.farm_steps) {
      if (typeof step !== 'string' || step.trim().length < 20 || step.trim().length > 600) {
        return `${r.slug} has a farm step of ${typeof step === 'string' ? step.trim().length : 0} characters, outside 20..600`;
      }
    }
  }

  if (board.length > 1 && board[0]!.implied_value_usd === board[board.length - 1]!.implied_value_usd) {
    return `every row shares the implied value ${board[0]!.implied_value_usd}`;
  }

  const missing = snapshot.watchlist.filter((slug) => !slugs.has(slug));
  if (missing.length > 0) return `the board misses ${missing.length} watchlist slug${missing.length === 1 ? '' : 's'}: ${missing.slice(0, 5).join(', ')}`;

  return null;
}

/** One spelling per value: object keys sorted, no whitespace. */
export function canonicalJson(value: unknown): string {
  if (value === null || typeof value === 'boolean' || typeof value === 'string') return JSON.stringify(value);
  if (typeof value === 'number') {
    if (!Number.isFinite(value)) throw new TypeError(`canonicalJson: ${value} is not a finite number`);
    return JSON.stringify(value);
  }
  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`;
  if (typeof value === 'object') {
    const o = value as Record<string, unknown>;
    return `{${Object.keys(o)
      .sort()
      .map((k) => `${JSON.stringify(k)}:${canonicalJson(o[k])}`)
      .join(',')}}`;
  }
  throw new TypeError(`canonicalJson: a ${typeof value} has no JSON form`);
}

/** The dashboard's whole dataset as one script, so the page reads no network. */
export function dataScript(radar: Radar): string {
  return `window.RADAR = ${canonicalJson(radar)};\n`;
}
